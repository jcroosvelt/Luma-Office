# Copiez ce fichier en .env.local pour le développement local avec « vercel dev » (ne jamais le publier).
# En production, ces valeurs se saisissent dans Vercel : Settings › Environment Variables. Ne mettez JAMAIS de vraies valeurs ici.

# --- Obligatoires ---
DATABASE_URL=                 # chaîne de connexion Neon/Postgres (utilisateur applicatif, SSL activé)
AUTH_SECRET=                  # 32 caractères aléatoires ou plus (chiffre les clés des comptes et signe les sessions). Voir docs/SECURITE.md
ADMIN_CODE=                   # code de l'administration (/admin) : 12 caractères ou plus recommandés
GEMINI_API_KEY=               # clé Google AI Studio de Judy

# --- Facultatives ---
# GEMINI_MODEL=               # modèle imposé (sinon choix automatique)
# AI_ACCESS_CODE=             # code d'accès à saisir dans l'app pour utiliser Judy
# AI_ALLOWED_ORIGINS=         # origines autorisées en plus du site (séparées par des virgules)
# AI_RATE_PER_MIN=20          # requêtes Judy par minute et par IP
# AI_RATE_PER_HOUR=120        # par heure et par IP
# AI_RATE_PER_DAY=600         # par jour et par IP
# AI_DAILY_MAX=8000           # plafond global par jour (protège le quota et la facture de la clé)
